# Copie para .env e ajuste se necessário:  cp .env.example .env
# ATENÇÃO: credenciais exclusivamente para o ambiente LOCAL de demonstração.

POSTGRES_DB=flowablelab
POSTGRES_USER=flowablelab
POSTGRES_PASSWORD=flowablelab-local-only

# Porta publicada do frontend (única exposta por padrão)
FRONTEND_PORT=4200

# Portas publicadas apenas com docker-compose.dev.yml
POSTGRES_PORT=5433
BACKEND_PORT=8080
BFF_PORT=3000

# BFF NestJS
BACKEND_URL=http://backend:8080
PROXY_TIMEOUT_MS=30000
BFF_LOG_LEVEL=log

# Cria exemplos de solicitações na primeira inicialização (idempotente)
DEMO_DATA_ENABLED=true

TZ=America/Sao_Paulo
